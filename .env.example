# ==============================================
# T.O.O.L.S Inc Portal Configuration
# ==============================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Azure OAuth Configuration
NEXT_PUBLIC_AZURE_CLIENT_ID=your-azure-client-id
NEXT_PUBLIC_AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_SECRET=your-azure-client-secret

# Environment
NODE_ENV=development

# Portal URLs (Production - Azure Static Web Apps)
NEXT_PUBLIC_MAIN_URL=https://www.sdtoolsinc.org
NEXT_PUBLIC_CLIENT_PORTAL_URL=https://toolsinc-client-portal.azurestaticapps.net
NEXT_PUBLIC_CASEMGR_PORTAL_URL=https://toolsinc-casemgr-portal.azurestaticapps.net
NEXT_PUBLIC_ADMIN_PORTAL_URL=https://toolsinc-admin-portal.azurestaticapps.net
NEXT_PUBLIC_HUB_URL=https://www.sdtoolsinc.org/portal
NEXT_PUBLIC_LEARNING_URL=https://www.sdtoolsinc.org/portal

# API Configuration
NEXT_PUBLIC_API_URL=https://api.sdtoolsinc.org
NEXT_PUBLIC_API_TIMEOUT=30000

# ==============================================
# AI Configuration - Choose ONE Option
# ==============================================

# ============== OPTION 1: FREE AI (Ollama) ===============
# Zero cost, runs locally, completely private
# See AI_FREE_SETUP.md for full instructions
#
# 1. Install Ollama: https://ollama.ai/download
# 2. Download model: ollama pull llama3.1:8b
# 3. Use these settings:

NEXT_PUBLIC_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_THREADS=8

# ============== OPTION 2: Azure OpenAI (Paid) ===============
# Enterprise-grade, cloud-based, requires Azure account
# See AI_IMPLEMENTATION_GUIDE.md for setup
#
# Uncomment these and comment out Option 1:

# NEXT_PUBLIC_AI_PROVIDER=azure-openai
# AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT_GPT4=gpt-4-turbo
# AZURE_OPENAI_DEPLOYMENT_GPT35=gpt-35-turbo
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ============== OPTION 3: OpenAI Direct (Paid) ===============
# Simpler than Azure but less control
#
# Uncomment these and comment out Option 1:

# NEXT_PUBLIC_AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_ORG_ID=your_org_id_optional

# ============== Common AI Settings ===============

NEXT_PUBLIC_AI_ENABLED=true
NEXT_PUBLIC_MACKAI_REAL_AI=true
NEXT_PUBLIC_OPENWEBUI_ENABLED=true

# AI Configuration Limits
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7
AI_TOP_P=0.95
AI_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_HOUR=500

# Open WebUI Integration (Full AI Interface)
NEXT_PUBLIC_OPENWEBUI_URL=https://toolsinc-openwebui.azurewebsites.net

# Application Insights (Optional - for AI monitoring)
APPINSIGHTS_INSTRUMENTATIONKEY=your_instrumentation_key
NEXT_PUBLIC_APPINSIGHTS_CONNECTION_STRING=your_connection_string
