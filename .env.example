# T.O.O.L.S Inc Web Application - Environment Variables
# Copy this to .env.local (development) or deploy to Key Vault (production)

# ============================================================================
# PUBLIC ENVIRONMENT VARIABLES (safe to expose, visible in client-side code)
# ============================================================================

# Application Metadata
NEXT_PUBLIC_APP_NAME=TOOLS Inc
NEXT_PUBLIC_APP_URL=https://sdtoolsinc.org
NEXT_PUBLIC_ENVIRONMENT=production

# Supabase Configuration (Authentication & Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Error Monitoring & Logging (Sentry)
NEXT_PUBLIC_SENTRY_DSN=https://your_key@sentry.io/your_project_id

# Analytics (Google Analytics)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Portal URLs (Production - Azure Static Web Apps)
NEXT_PUBLIC_MAIN_URL=https://www.sdtoolsinc.org
NEXT_PUBLIC_CLIENT_PORTAL_URL=https://toolsinc-client-portal.azurestaticapps.net
NEXT_PUBLIC_CASEMGR_PORTAL_URL=https://toolsinc-casemgr-portal.azurestaticapps.net
NEXT_PUBLIC_ADMIN_PORTAL_URL=https://toolsinc-admin-portal.azurestaticapps.net
NEXT_PUBLIC_HUB_URL=https://www.sdtoolsinc.org/portal
NEXT_PUBLIC_LEARNING_URL=https://www.sdtoolsinc.org/portal

# API Configuration
NEXT_PUBLIC_API_URL=https://api.sdtoolsinc.org
NEXT_PUBLIC_API_TIMEOUT=30000

# Feature Flags
NEXT_PUBLIC_ENABLE_BETA_FEATURES=false
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true

# AI Configuration (Choose ONE provider)
NEXT_PUBLIC_AI_PROVIDER=ollama  # options: ollama, azure-openai, openai
NEXT_PUBLIC_AI_ENABLED=true
NEXT_PUBLIC_MACKAI_REAL_AI=true
NEXT_PUBLIC_OPENWEBUI_ENABLED=true
NEXT_PUBLIC_OPENWEBUI_URL=https://toolsinc-openwebui.azurewebsites.net

# ============================================================================
# SECRET ENVIRONMENT VARIABLES (NEVER commit, store in Key Vault/secrets)
# ============================================================================

# Supabase Admin Access (Backend/API only)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Email Service (Resend API)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@sdtoolsinc.org

# Error Monitoring (Sentry - for backend error reporting)
SENTRY_DSN=https://your_key@sentry.io/your_project_id
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Authentication & Encryption
JWT_SECRET=your-secret-key-min-32-characters-long
ENCRYPTION_KEY=your-encryption-key-min-32-characters-long

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORE=memory  # or "redis" for distributed rate limiting

# Database Connection (if using direct database access)
DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT=30000

# Session Configuration
SESSION_SECRET=your-session-secret-key-min-32-characters
SESSION_MAX_AGE=86400  # 24 hours in seconds
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=Lax

# AI Configuration - API Keys (select based on provider above)
# OPTION 1: Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_THREADS=8

# OPTION 2: Azure OpenAI
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_GPT4=gpt-4-turbo
AZURE_OPENAI_DEPLOYMENT_GPT35=gpt-35-turbo
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# OPTION 3: OpenAI Direct
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORG_ID=your_org_id_optional

# AI Configuration Limits
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7
AI_TOP_P=0.95
AI_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_HOUR=500

# Azure OAuth Configuration (if using Azure AD)
NEXT_PUBLIC_AZURE_CLIENT_ID=your-azure-client-id
NEXT_PUBLIC_AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_SECRET=your-azure-client-secret

# Email Service Configuration (SendGrid - legacy)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
SMTP_FROM_EMAIL=noreply@sdtoolsinc.org

# Feature Flags for Admin
ENABLE_AUTO_APPROVAL=false
ENABLE_EMAIL_NOTIFICATIONS=true

# Application Insights (Optional - for monitoring)
APPINSIGHTS_INSTRUMENTATIONKEY=your_instrumentation_key
NEXT_PUBLIC_APPINSIGHTS_CONNECTION_STRING=your_connection_string

# Admin Portal Security
ADMIN_DASHBOARD_SECRET_KEY=your-admin-secret-key-here
ADMIN_TWO_FACTOR_ENABLED=true

# Webhook Security
WEBHOOK_SIGNING_SECRET=your-webhook-signing-secret

# ============================================================================
# NODE ENVIRONMENT (automatically set by deployment platform)
# ============================================================================

NODE_ENV=production  # development, staging, or production

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================

# 1. DEVELOPMENT SETUP (.env.local)
#    cp .env.example .env.local
#    # Edit .env.local with development values
#    # DO NOT commit .env.local

# 2. PRODUCTION SETUP (Azure Key Vault)
#    az keyvault secret set --vault-name toolsinc-kv --name RESEND_API_KEY --value "re_..."
#    az keyvault secret set --vault-name toolsinc-kv --name SENTRY_DSN --value "https://..."
#    # etc for each secret

# 3. VERIFY VARIABLES
#    npm run dev  # Should start without errors
#    # Check browser console - no undefined env var errors

# ============================================================================
# TROUBLESHOOTING
# ============================================================================

# Issue: "Cannot find module 'resend'"
# Fix: npm install resend

# Issue: Sentry not capturing errors
# Fix: Verify NEXT_PUBLIC_SENTRY_DSN is set, check Sentry project settings

# Issue: Email not sending
# Fix: Verify RESEND_API_KEY, check sender email is verified in Resend

# Issue: Database connection timeout
# Fix: Verify DATABASE_URL, check database is accessible, increase POOL_MAX

# Issue: "Missing environment variable"
# Fix: Add variable to .env.local or Key Vault, restart app

# ============================================================================
# LAST UPDATED: February 14, 2026
# ============================================================================

