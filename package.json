{
  "name": "toolsinc-dashdarkx",
  "private": true,
  "version": "1.1.0",
  "description": "T.O.O.L.S Inc enterprise demo desktop application",
  "author": "T.O.O.L.S Inc",
  "type": "module",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "export": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "e2e": "cypress run",
    "e2e:open": "cypress open",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "pack": "npm run export && electron-builder --dir",
    "dist": "node scripts/electron-dist.mjs",
    "dist:demo": "npm run export && node scripts/electron-dist.mjs",
    "health-check": "node scripts/health-check.cjs",
    "check-updates": "npm outdated",
    "security-audit": "npm audit",
    "deps:check": "node scripts/manage-dependencies.js",
    "deps:audit-all": "npm audit && cd apps/client-portal && npm audit && cd ../casemgr-portal && npm audit && cd ../admin-portal && npm audit && cd ../../api && npm audit",
    "deps:update-root": "npm update",
    "deps:update-portals": "cd apps/client-portal && npm update && cd ../casemgr-portal && npm update && cd ../admin-portal && npm update && cd ..",
    "deps:update-all": "npm update && npm run deps:update-portals && cd api && npm update",
    "analyze": "ANALYZE=true next build",
    "verify": "bash scripts/verify-performance.sh",
    "optimize-logos": "node scripts/optimize-logos.js",
    "docker:build": "docker build -t toolsinc-web:latest .",
    "docker:run": "docker run -d -p 3000:3000 --name toolsinc-web toolsinc-web:latest",
    "docker:stop": "docker stop toolsinc-web && docker rm toolsinc-web",
    "docker:logs": "docker logs -f toolsinc-web",
    "compose:up": "docker-compose up -d",
    "compose:down": "docker-compose down",
    "compose:logs": "docker-compose logs -f",
    "prepare": "husky",
    "seed:client-users": "node scripts/seed-client-users.cjs",
    "distribute:client-usernames": "node scripts/distribute-client-usernames.cjs"
  },
  "dependencies": {
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@sentry/nextjs": "^10.55.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.3.1",
    "@vercel/kv": "^3.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "clsx": "^2.1.1",
    "convex": "^1.34.0",
    "framer-motion": "^11.18.2",
    "googleapis": "^171.4.0",
    "jose": "^5.10.0",
    "lucide-react": "^0.563.0",
    "mammoth": "^1.12.0",
    "next": "^16.1.5",
    "next-auth": "^5.0.0-beta.31",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "resend": "^6.9.4",
    "sharp": "^0.34.5",
    "serve": "^14.2.5",
    "tailwind-merge": "^2.6.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.6",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^4.1.7",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "cypress": "^15.16.0",
    "dotenv-cli": "^11.0.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.0.0",
    "electron-is-dev": "^3.0.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.8.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.sdtoolsinc.demo",
    "productName": "T.O.O.L.S Inc - Enterprise Preview",
    "copyright": "Copyright © 2024 T.O.O.L.S Inc. All rights reserved.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "T.O.O.L.S Inc Preview",
      "runAfterFinish": true,
      "perMachine": false,
      "license": "LICENSE"
    },
    "msi": {
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "T.O.O.L.S Inc Preview"
    },
    "extraMetadata": {
      "main": "electron/main.js"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix"
    ],
    "*.{json,md,css,scss,yml,yaml}": [
      "prettier --write"
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
