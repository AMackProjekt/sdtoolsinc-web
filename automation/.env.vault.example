# Automation Environment Variables
# All secrets should be stored in Azure Key Vault
# NEVER commit real API keys to version control

# Azure Key Vault - Secrets Management
AZURE_KEYVAULT_URL=https://<your-keyvault-name>.vault.azure.net/
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Social Media Platforms
# Store these in Key Vault as:
# - automation-openai-api-key
# - automation-twitter-api-key
# - automation-facebook-api-key
# - automation-instagram-api-key
# - automation-linkedin-api-key
# - automation-tiktok-api-key
OPENAI_API_KEY=
TWITTER_API_KEY=
TWITTER_API_SECRET=
FACEBOOK_PAGE_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=

# Database
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=

# Security
NODE_ENV=production
LOG_LEVEL=info

# Schedule Configuration
ENABLE_SCHEDULING=true
SCHEDULE_TIMEZONE=America/New_York
