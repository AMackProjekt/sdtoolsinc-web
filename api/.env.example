# Azure SQL Database Configuration
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=your-database-name
AZURE_SQL_USER=your-admin-username
AZURE_SQL_PASSWORD=your-secure-password

# Supabase JWT Secret (for token verification)
# Get this from your Supabase project settings > API > JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Azure Communication Services (for email notifications)
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://your-acs.communication.azure.com/;accesskey=your-key

# Smoke Test Configuration (optional)
# SMOKE_TEST_URL=http://localhost:7071
# SMOKE_TEST_URL=https://your-app-name.azurewebsites.net

# Node Environment
NODE_ENV=development
