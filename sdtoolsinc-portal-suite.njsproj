<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{00000000-0000-0000-0000-000000000000}</ProjectGuid>
    <ProjectTypeGuids>{24D3C2F3-2C8F-4B32-9D82-1C4B1E8A9C9A};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <Name>sdtoolsinc-portal-suite</Name>
  </PropertyGroup>

  <!-- Conditionally import Node.js Tools targets if they are installed on the build machine. -->
  <Import Project="$(VSToolsPath)\Node.js Tools\Microsoft.NodejsToolsV2.targets" Condition="Exists('$(VSToolsPath)\Node.js Tools\Microsoft.NodejsToolsV2.targets')" />

  <!-- Minimal targets so MSBuild has something to run if Node tools are not present. -->
  <Target Name="Build">
    <Message Text="Building sdtoolsinc-portal-suite (placeholder project)." Importance="High" />
  </Target>
</Project>
