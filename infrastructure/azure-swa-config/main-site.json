{
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/admin",
      "redirect": "https://admin.sdtoolsinc.org",
      "statusCode": 301
    },
    {
      "route": "/client",
      "redirect": "https://client.sdtoolsinc.org",
      "statusCode": 301
    },
    {
      "route": "/staff",
      "redirect": "https://staff.sdtoolsinc.org",
      "statusCode": 301
    },
    {
      "route": "/portals",
      "redirect": "https://portal.sdtoolsinc.org",
      "statusCode": 301
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  },
  "globalHeaders": {
    "X-Frame-Options": "DENY",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "geolocation=(), microphone=(), camera=()"
  },
  "customDomains": [
    "www.sdtoolsinc.org",
    "sdtoolsinc.org"
  ]
}
