<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Desktop Build Properties -->
  <PropertyGroup>
    <DesktopProjectRoot>$(ProjectRoot)</DesktopProjectRoot>
    <DesktopOutputPath>$(OutputPath)desktop\</DesktopOutputPath>
    <DesktopDistPath>$(DesktopProjectRoot)dist-rebuild\</DesktopDistPath>
    <ElectronMainPath>$(DesktopProjectRoot)electron\main.js</ElectronMainPath>
    <ElectronPreloadPath>$(DesktopProjectRoot)electron\preload.js</ElectronPreloadPath>
  </PropertyGroup>

  <!-- Restore Desktop Dependencies -->
  <Target Name="RestoreDesktopDependencies">
    <Message Text="Restoring desktop dependencies..." Importance="high" />
    <Exec Command="npm ci --prefer-offline" WorkingDirectory="$(DesktopProjectRoot)" ContinueOnError="false" />
    <Message Text="Desktop dependencies restored" Importance="high" />
  </Target>

  <!-- Build Desktop (Development) -->
  <Target Name="BuildDesktopDev" DependsOnTargets="RestoreDesktopDependencies">
    <Message Text="Building desktop application (Development)..." Importance="high" />
    <Exec Command="npm run electron-dev" WorkingDirectory="$(DesktopProjectRoot)" ContinueOnError="false" />
  </Target>

  <!-- Build Desktop (Production - MSI) -->
  <Target Name="BuildDesktop" DependsOnTargets="CleanDesktop;RestoreDesktopDependencies;BuildWeb">
    <Message Text="Building desktop application (Production MSI)..." Importance="high" />
    <Message Text="Configuration: $(Configuration)" Importance="normal" />
    
    <!-- Build Next.js static export for desktop (already done in BuildWeb) -->
    <Message Text="Using web build from: $(WebDistPath)" Importance="normal" />
    
    <!-- Build Electron application and MSI -->
    <Exec Command="npm run build:electron" WorkingDirectory="$(DesktopProjectRoot)" ContinueOnError="false" />
    
    <!-- Copy MSI and installers to output -->
    <Message Text="Copying desktop build to output..." Importance="normal" />
    <ItemGroup>
      <DesktopDistFiles Include="$(DesktopDistPath)**\*.exe;$(DesktopDistPath)**\*.msi;$(DesktopDistPath)**\*.blockmap" />
    </ItemGroup>
    <Copy SourceFiles="@(DesktopDistFiles)" DestinationFolder="$(DesktopOutputPath)" />
    
    <Message Text="Desktop build complete: $(DesktopOutputPath)" Importance="high" />
  </Target>

  <!-- Build Desktop (MSI Only) -->
  <Target Name="BuildDesktopMSI" DependsOnTargets="CleanDesktop;RestoreDesktopDependencies">
    <Message Text="Building desktop MSI installer..." Importance="high" />
    <Exec Command="npm run electron:package" WorkingDirectory="$(DesktopProjectRoot)" ContinueOnError="false" />
    
    <!-- Copy MSI to output -->
    <ItemGroup>
      <DesktopMSIFiles Include="$(DesktopDistPath)**\*.msi;$(DesktopDistPath)**\*.blockmap" />
    </ItemGroup>
    <Copy SourceFiles="@(DesktopMSIFiles)" DestinationFolder="$(DesktopOutputPath)" />
    
    <Message Text="Desktop MSI build complete: $(DesktopOutputPath)" Importance="high" />
  </Target>

  <!-- Test Desktop -->
  <Target Name="TestDesktop" DependsOnTargets="RestoreDesktopDependencies">
    <Message Text="Running desktop tests..." Importance="high" />
    <Exec Command="npm run test" WorkingDirectory="$(DesktopProjectRoot)" ContinueOnError="true" />
  </Target>

  <!-- Clean Desktop Build -->
  <Target Name="CleanDesktop">
    <Message Text="Cleaning desktop build artifacts..." Importance="normal" />
    <RemoveDir Directories="$(DesktopDistPath)" Condition="Exists('$(DesktopDistPath)')" />
    <RemoveDir Directories="$(DesktopOutputPath)" Condition="Exists('$(DesktopOutputPath)')" />
    <!-- Clean Node modules from Electron folder if needed for space -->
    <!-- <RemoveDir Directories="$(DesktopProjectRoot)node_modules\" Condition="Exists('$(DesktopProjectRoot)node_modules\')" /> -->
  </Target>

  <!-- Start Desktop Dev -->
  <Target Name="StartDesktopDev" DependsOnTargets="RestoreDesktopDependencies">
    <Message Text="Starting Electron development environment..." Importance="high" />
    <Exec Command="npm run electron-dev" WorkingDirectory="$(DesktopProjectRoot)" />
  </Target>

  <!-- Validate Desktop Configuration -->
  <Target Name="ValidateDesktopConfig">
    <Message Text="Validating Electron configuration..." Importance="normal" />
    <Error Text="Electron main.js not found at $(ElectronMainPath)" Condition="!Exists('$(ElectronMainPath)')" />
    <Error Text="Electron preload.js not found at $(ElectronPreloadPath)" Condition="!Exists('$(ElectronPreloadPath)')" />
    <Message Text="Electron configuration valid" Importance="normal" />
  </Target>

  <!-- Package Desktop Portable -->
  <Target Name="PackageDesktopPortable" DependsOnTargets="RestoreDesktopDependencies">
    <Message Text="Packaging desktop as portable executable..." Importance="high" />
    <Exec Command="npm run electron:portable" WorkingDirectory="$(DesktopProjectRoot)" ContinueOnError="true" />
  </Target>

</Project>
