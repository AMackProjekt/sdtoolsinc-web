<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="All" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  
  <!-- Properties Configuration -->
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">Any CPU</Platform>
    <OutputPath>$(MSBuildThisFileDirectory)..\dist\</OutputPath>
    <BuildTempPath>$(MSBuildThisFileDirectory)..\obj\</BuildTempPath>
    <LogsPath>$(BuildTempPath)logs\</LogsPath>
    <ProjectRoot>$(MSBuildThisFileDirectory)..\</ProjectRoot>
  </PropertyGroup>

  <!-- Import platform-specific build targets -->
  <Import Project="$(MSBuildThisFileDirectory)Web.targets" />
  <Import Project="$(MSBuildThisFileDirectory)Desktop.targets" />
  <Import Project="$(MSBuildThisFileDirectory)Mobile.targets" />

  <!-- Main Build Targets -->
  
  <!-- Build All Platforms -->
  <Target Name="All" DependsOnTargets="BuildWeb;BuildDesktop;BuildMobile">
    <Message Text="========================================" Importance="high" />
    <Message Text="Multi-Platform Build Complete" Importance="high" />
    <Message Text="========================================" Importance="high" />
    <Message Text="Web:     $(OutputPath)web\" Importance="high" />
    <Message Text="Desktop: $(OutputPath)desktop\" Importance="high" />
    <Message Text="Mobile:  $(OutputPath)mobile\" Importance="high" />
  </Target>

  <!-- Build Production -->
  <Target Name="BuildProduction" DependsOnTargets="Clean;All">
    <Message Text="Production build completed" Importance="high" />
  </Target>

  <!-- Build Web + Desktop (Common Scenarios) -->
  <Target Name="BuildWeb-Desktop" DependsOnTargets="BuildWeb;BuildDesktop">
    <Message Text="Web + Desktop build completed" Importance="high" />
  </Target>

  <!-- Install Dependencies -->
  <Target Name="RestoreDependencies" DependsOnTargets="RestoreWebDependencies;RestoreDesktopDependencies;RestoreMobileDependencies">
    <Message Text="All dependencies restored" Importance="high" />
  </Target>

  <!-- Validate Environment -->
  <Target Name="ValidateEnvironment">
    <Message Text="Validating build environment..." Importance="high" />
    <Message Text="Node.js version:" Importance="high" />
    <Exec Command="node --version" ContinueOnError="true" />
    <Message Text="npm version:" Importance="high" />
    <Exec Command="npm --version" ContinueOnError="true" />
    <Message Text="Environment validation complete" Importance="high" />
  </Target>

  <!-- Clean All Outputs -->
  <Target Name="Clean" DependsOnTargets="CleanWeb;CleanDesktop;CleanMobile">
    <RemoveDir Directories="$(OutputPath)" />
    <Message Text="All build artifacts cleaned" Importance="high" />
  </Target>

  <!-- Create Build Directories -->
  <Target Name="CreateDirectories">
    <MakeDir Directories="$(OutputPath)" Condition="!Exists('$(OutputPath)')" />
    <MakeDir Directories="$(BuildTempPath)" Condition="!Exists('$(BuildTempPath)')" />
    <MakeDir Directories="$(LogsPath)" Condition="!Exists('$(LogsPath)')" />
  </Target>

  <!-- Run All Tests -->
  <Target Name="Test" DependsOnTargets="TestWeb;TestDesktop;TestMobile">
    <Message Text="All platform tests completed" Importance="high" />
  </Target>

  <!-- Default test stubs - override in platform-specific files -->
  <Target Name="TestWeb" Condition="'$(SkipTests)' != 'true'">
    <Message Text="Running web tests..." Importance="normal" />
  </Target>

  <Target Name="TestDesktop" Condition="'$(SkipTests)' != 'true'">
    <Message Text="Running desktop tests..." Importance="normal" />
  </Target>

  <Target Name="TestMobile" Condition="'$(SkipTests)' != 'true'">
    <Message Text="Running mobile tests..." Importance="normal" />
  </Target>

</Project>
