# Client Portal - Secure Environment Configuration
# All secrets must be stored in Azure Key Vault

# Azure Key Vault
NEXT_PUBLIC_KEYVAULT_URL=https://<your-keyvault-name>.vault.azure.net/
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# API Configuration
NEXT_PUBLIC_API_ENDPOINT=/api

# Authentication (Azure Entra ID)
NEXT_PUBLIC_AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# Security
NEXT_PUBLIC_CSP_CONNECT_SRC=
NEXT_PUBLIC_ALLOWED_ORIGINS=
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Logging
LOG_LEVEL=info
