# T.O.O.L.S Inc Client Portal - Production Environment Variables
# Copy this file to .env.production and fill in your production values

# =============================================================================
# SUPABASE CONFIGURATION (REQUIRED)
# =============================================================================
# Get these from your Supabase project dashboard: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# API CONFIGURATION (REQUIRED)
# =============================================================================
# Base URL for your backend API (Azure Functions, Express server, etc.)
# Example: https://api.sdtoolsinc.com or https://your-function-app.azurewebsites.net/api
NEXT_PUBLIC_API_BASE=https://your-api-url.com/api

# =============================================================================
# SECURITY & AUTH CONFIGURATION
# =============================================================================

# Invite-Only Signup
# Set to 'true' to require invite codes during signup, 'false' to allow open registration
NEXT_PUBLIC_REQUIRE_INVITE_CODE=true

# Valid invite codes (comma-separated, case-insensitive)
# Example: WELCOME2024,REENTRY2024,JUSTICE2024
# Keep these codes secure and rotate them regularly
NEXT_PUBLIC_PORTAL_INVITE_CODES=WELCOME2024,REENTRY2024

# Email Domain Allowlist (optional)
# Comma-separated list of allowed email domains for signup
# Leave empty to allow all domains
# Example: gmail.com,yahoo.com,outlook.com,organization.org
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=

# Session Timeout
# Number of minutes of inactivity before automatic sign-out
# Default: 30 minutes (recommended for security)
# Range: 15-120 minutes
NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES=30

# =============================================================================
# MICROSOFT SSO (OPTIONAL)
# =============================================================================
# If you want to enable "Sign in with Microsoft" button
# Get these from Azure AD App Registration: https://portal.azure.com/#view/Microsoft_AAD_IAM/ActiveDirectoryMenuBlade/~/RegisteredApps
# NEXT_PUBLIC_AZURE_CLIENT_ID=your-azure-client-id
# NEXT_PUBLIC_AZURE_TENANT_ID=your-azure-tenant-id (or 'common' for multi-tenant)

# =============================================================================
# ANALYTICS & MONITORING (OPTIONAL)
# =============================================================================
# Application Insights connection string (for Azure monitoring)
# NEXT_PUBLIC_APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=xxx;IngestionEndpoint=https://...

# Sentry DSN (for error tracking)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# =============================================================================
# FEATURE FLAGS (OPTIONAL)
# =============================================================================
# Enable/disable specific portal features
# NEXT_PUBLIC_ENABLE_COURSES=true
# NEXT_PUBLIC_ENABLE_JOURNAL=true
# NEXT_PUBLIC_ENABLE_MESSAGES=true

# =============================================================================
# NOTES & SECURITY REMINDERS
# =============================================================================
# 
# REQUIRED BACKEND SETUP:
# 1. All API endpoints must validate:
#    - Email verification status (user.email_confirmed_at exists)
#    - Approval status (user.user_metadata.approval_status === 'approved')
#    - User role (user.app_metadata.role === 'client')
#    - JWT token validity and expiration
# 
# 2. Implement these backend endpoints:
#    POST /v1/audit-events - Receive audit logs from client
#    GET  /v1/client/dashboard - Dashboard data
#    GET  /v1/client/messages - User messages
#    GET  /v1/client/journal - Journal entries
#    POST /v1/client/journal - Create journal entry
#    GET  /v1/client/profile - User profile
#    PUT  /v1/client/profile - Update profile
# 
# 3. Staff admin portal needs user management UI to:
#    - View users with approval_status='pending'
#    - Update user_metadata.approval_status to 'approved' or 'rejected'
#    - Send approval/rejection notification emails
# 
# SECURITY BEST PRACTICES:
# - Never commit .env.production to version control (add to .gitignore)
# - Rotate invite codes regularly (monthly or after major signups)
# - Use strong, unique values for all secrets
# - Enable HTTPS in production (required for secure auth)
# - Monitor audit logs for suspicious activity
# - Set up alerts for failed login attempts
# - Review and approve new users promptly
# 
# DEPLOYMENT CHECKLIST:
# [ ] Copy this file to .env.production
# [ ] Fill in all REQUIRED values above
# [ ] Test signup flow with invite code
# [ ] Test email verification workflow
# [ ] Test approval workflow (pending -> approved)
# [ ] Test session timeout (wait NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES + 1 min)
# [ ] Test new device detection (sign in from different browser)
# [ ] Verify all API endpoints return real data (not mocks)
# [ ] Configure Azure Static Web Apps environment variables (if deploying to Azure)
# [ ] Set up email templates in Supabase for verification/password reset
# [ ] Configure Supabase Auth settings (redirect URLs, email templates)
