{
  "appId": "com.toolsinc.client",
  "productName": "TOOLS Client Portal",
  "directories": {
    "buildResources": "build",
    "output": "dist-electron"
  },
  "files": [
    "out/**/*",
    "electron/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "electron/main.js"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "msi",
        "arch": ["x64"]
      }
    ],
    "icon": "public/logos/tools-logo.png",
    "artifactName": "TOOLS-Client-Setup-${version}.${ext}",
    "publisherName": "T.O.O.L.S Inc"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "public/logos/tools-logo.png",
    "uninstallerIcon": "public/logos/tools-logo.png",
    "installerHeaderIcon": "public/logos/tools-logo.png",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "TOOLS Client Portal"
  },
  "msi": {
    "artifactName": "TOOLS-Client-${version}.${ext}",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "TOOLS Client Portal"
  },
  "mac": {
    "target": ["dmg"],
    "icon": "public/logos/tools-logo.png",
    "category": "public.app-category.business"
  },
  "linux": {
    "target": ["AppImage"],
    "icon": "public/logos/tools-logo.png",
    "category": "Office"
  }
}
